{
  "name": "nba-auction-game",
  "version": "1.0.0",
  "private": true,
  "description": "משחק מכרז שחקנים בזמן אמת",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "build": "npm run setup && npm --prefix client run build",
    "start": "node server/server.js",
    "serve": "npm run build && npm start",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "node server/server.js",
    "lint": "npm --prefix client run lint"
  }
}
